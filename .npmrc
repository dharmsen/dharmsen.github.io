# Security: do not execute dependency install/lifecycle scripts (postinstall, etc.)
# during `npm ci`/`npm install`. This site's dependencies (astro, @astrojs/*,
# @fontsource/*, typescript, esbuild via optionalDependencies) build fine without
# them, verified via the deploy pipeline. If a future dependency genuinely needs an
# install script, re-enable it explicitly with `npm install --ignore-scripts=false`.
ignore-scripts=true
